# Vibey Framework .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Project-specific (these are generated when Vibey is deployed)
# Do NOT ignore these in the framework repo itself
# .claude/project-config.yaml  # Generated in user projects
# .claude/CLAUDE.md            # Generated in user projects
# docs/                        # User project documentation

# Temporary files
*.tmp
*.log
*.bak
.cache/

# OS files
Thumbs.db
.DS_Store
.claude/
