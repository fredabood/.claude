# Vibey Framework .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Platform Deployments (Generated by vibey deploy)
# These directories are generated from .vibey/ source of truth
# and should NOT be committed in the framework repo
.claude
.goose/
.goosehints
.cursor/
.cursorrules
.aider/
.continue/

# Config Backups (Generated by vibey config migrate)
.vibey/config-backups/
.vibey/.migration-declined

# Checkpoint Backups (Generated by checkpoint scripts)
.vibey-checkpoints/

# Project-specific (these are generated when Vibey is deployed)
# Do NOT ignore these in the framework repo itself
# .claude/project-config.yaml  # Generated in user projects
# .claude/CLAUDE.md            # Generated in user projects
# docs/                        # User project documentation

# Temporary files
*.tmp
*.log
*.bak
.cache/

# OS files
Thumbs.db
.DS_Store
.mcp.json

# Generated platform exports (test output)
goose-export/
.vibey/backups/

# Legacy hierarchical roadmap directories (migrated to flat structure)
# Prevent accidental creation of ULID-named directories in roadmap root
.vibey/roadmap/01*/
