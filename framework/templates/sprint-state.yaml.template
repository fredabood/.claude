# Sprint State Tracking
# Auto-generated by Vibey Framework
# This file tracks the current state of sprint execution
# DO NOT manually edit unless you know what you're doing

sprint:
  number: {{ sprint_number }}
  name: "{{ sprint_name }}"
  status: "not_started"  # not_started, in_progress, paused, completed
  started: null
  paused: null
  completed: null
  plan_file: "{{ sprint_plan_file }}"

current_phase:
  number: null
  name: null
  status: null  # not_started, in_progress, completed
  started: null
  completed: null

phases: []
  # Will be populated with:
  # - number: 1
  #   name: "Phase Name"
  #   status: "not_started"  # not_started, in_progress, completed
  #   progress_percent: 0
  #   started: null
  #   completed: null
  #   agents_run: []
  #     # - name: "agent-name"
  #     #   timestamp: "2025-11-05T10:30:00"
  #     #   status: "completed"
  #     #   notes: ""
  #   tasks: []
  #     # - description: "Task description"
  #     #   completed: false
  #     #   completed_at: null
  #   quality_gates: []
  #     # - name: "Security Audit"
  #     #   status: "not_run"  # not_run, running, passed, failed
  #     #   score: null
  #     #   threshold: 85
  #     #   blocking: true
  #     #   checked_at: null
  #     #   issues: []

activity_log: []
  # Will be populated with:
  # - timestamp: "2025-11-05T10:30:00"
  #   type: "sprint_started|phase_started|phase_completed|agent_execution|quality_gate|task_completed|note"
  #   description: "Human-readable description"
  #   metadata: {}

metadata:
  created_at: "{{ created_at }}"
  last_updated: "{{ created_at }}"
  framework_version: "2.0"
  state_schema_version: "1.0"
