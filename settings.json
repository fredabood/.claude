{
  "permissions": {
    "allow": [
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Bash(brew *)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(uv *)",
      "Bash(jq *)",
      "Bash(bash *)",
      "Bash(curl *)",
      "Bash(xcode-select *)",
      "Bash(cd *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(ln *)",
      "Bash(rm *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(which *)",
      "Bash(command *)",
      "Bash(source *)",
      "Bash(eval *)",
      "Bash(chmod *)",
      "Bash(ssh *)",
      "Bash(databricks *)",
      "Bash(python *)",
      "Bash(nohup *)",
      "Bash(tr *)",
      "Bash(test *)",
      "Bash(date *)",
      "Bash(sleep *)",
      "Bash(jobs *)",
      "WebFetch(domain:www.databricks.com)",
      "WebFetch(domain:docs.databricks.com)",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-tests.sh",
            "timeout": 120,
            "statusMessage": "Running pre-commit quality gates..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/memory-frontmatter-check.sh",
            "timeout": 30,
            "statusMessage": "Validating vault frontmatter..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/ticket-reference-check.sh",
            "timeout": 10,
            "statusMessage": "Checking for work item reference..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/workflow-gate.sh",
            "timeout": 5,
            "statusMessage": "Checking workflow gates..."
          }
        ]
      },
      {
        "matcher": "Bash(docker stop *)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/docker-safety-check.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash(docker rm *)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/docker-safety-check.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash(docker rmi *)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/docker-safety-check.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash(docker kill *)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/docker-safety-check.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash(cat .env*)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/env-secret-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking .env access..."
          }
        ]
      },
      {
        "matcher": "Bash(grep * .env*)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/env-secret-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking .env access..."
          }
        ]
      },
      {
        "matcher": "Bash(head * .env*)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/env-secret-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking .env access..."
          }
        ]
      },
      {
        "matcher": "Bash(tail * .env*)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/env-secret-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking .env access..."
          }
        ]
      },
      {
        "matcher": "Bash(source .env*)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/env-secret-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking .env access..."
          }
        ]
      },
      {
        "matcher": "Read(.env)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/env-secret-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking .env access..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/workflow-gate.sh",
            "timeout": 5,
            "statusMessage": "Checking workflow gates..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/workflow-gate.sh",
            "timeout": 5,
            "statusMessage": "Checking workflow gates..."
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Atlassian__transitionJiraIssue",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/workflow-gate.sh",
            "timeout": 5,
            "statusMessage": "Checking workflow gates..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/atlassian-skill-gate.sh",
            "timeout": 5,
            "statusMessage": "Checking skill execution context..."
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Atlassian__createJiraIssue",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/label-taxonomy-check.sh",
            "timeout": 10,
            "statusMessage": "Validating taxonomy labels..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/atlassian-skill-gate.sh",
            "timeout": 5,
            "statusMessage": "Checking skill execution context..."
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Atlassian__editJiraIssue",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/label-taxonomy-check.sh",
            "timeout": 10,
            "statusMessage": "Validating taxonomy labels..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/atlassian-skill-gate.sh",
            "timeout": 5,
            "statusMessage": "Checking skill execution context..."
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Atlassian__createIssueLink",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/link-direction-check.sh",
            "timeout": 10,
            "statusMessage": "Checking link direction..."
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Atlassian__addCommentToJiraIssue",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/atlassian-skill-gate.sh",
            "timeout": 5,
            "statusMessage": "Checking skill execution context..."
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Atlassian__addWorklogToJiraIssue",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/atlassian-skill-gate.sh",
            "timeout": 5,
            "statusMessage": "Checking skill execution context..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/persistence-safety-net.sh",
            "timeout": 10000,
            "statusMessage": "Checking for unsaved decisions..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/prompt-router.sh",
            "timeout": 5000,
            "statusMessage": "Checking for skill suggestions..."
          }
        ]
      }
    ]
  }
}
