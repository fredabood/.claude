#!/bin/bash
#
# Vibey Roadmap Post Commit Hook
#
# This hook detects when pre-commit was bypassed for roadmap
# file changes and logs the event to the audit log.
#
# Installation:
#   vibey roadmap install-hooks
#
# Task: git-integration-5-task-007

# Don't fail on errors in post-commit (it's already committed)
set +e

# Run Python post-commit hook
python3 -c "
from vibey.operations.git.hooks.post_commit import main
import sys
sys.exit(main())
" 2>/dev/null

# Always exit 0 - post-commit shouldn't block anything
exit 0
