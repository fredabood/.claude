#!/bin/bash
#
# Vibey Roadmap Pre-Commit Hook
#
# This hook validates roadmap data before allowing commits.
# It runs when .vibey/roadmap/ files are modified.
#
# Installation:
#   vibey roadmap install-hooks
#
# Bypass (emergency only):
#   git commit --no-verify
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Check if roadmap files are being committed
roadmap_files_changed=$(git diff --cached --name-only | grep "^.vibey/roadmap/" || true)

if [ -z "$roadmap_files_changed" ]; then
    # No roadmap files changed, skip validation
    exit 0
fi

echo ""
echo -e "${BLUE}🔍 Roadmap files changed, running validation...${NC}"
echo ""

# Show which files changed
echo -e "${YELLOW}Modified roadmap files:${NC}"
echo "$roadmap_files_changed" | sed 's/^/  - /'
echo ""

# Run fast validation first (quick syntax check)
echo -e "${BLUE}Running fast validation...${NC}"
if python3 -m vibey.cli.main roadmap validate-fast --profile quick 2>&1; then
    echo -e "${GREEN}✅ Fast validation passed${NC}"
else
    echo ""
    echo -e "${RED}❌ Fast validation failed!${NC}"
    echo ""
    echo -e "${YELLOW}Fix the validation errors above before committing.${NC}"
    echo -e "${YELLOW}To bypass this check (emergency only): git commit --no-verify${NC}"
    echo ""
    exit 1
fi

# Check if advanced validation should run (optional, controlled by config)
VIBEY_HOOK_ADVANCED=${VIBEY_HOOK_ADVANCED:-false}

if [ "$VIBEY_HOOK_ADVANCED" = "true" ]; then
    echo ""
    echo -e "${BLUE}Running advanced validation...${NC}"
    if python3 -m vibey.cli.main roadmap validate-advanced 2>&1; then
        echo -e "${GREEN}✅ Advanced validation passed${NC}"
    else
        echo ""
        echo -e "${RED}❌ Advanced validation found issues!${NC}"
        echo ""
        echo -e "${YELLOW}Consider fixing these issues before committing.${NC}"
        echo -e "${YELLOW}To bypass this check: git commit --no-verify${NC}"
        echo ""
        exit 1
    fi
fi

echo ""
echo -e "${GREEN}✅ All roadmap validations passed!${NC}"
echo ""

exit 0
