#!/bin/bash
#
# Vibey Roadmap Pre-Push Hook
#
# This hook verifies that all commits being pushed have valid
# activity log entries for any roadmap file changes.
#
# Installation:
#   vibey roadmap install-hooks
#
# Bypass (emergency only):
#   git push --no-verify
#
# Task: git-integration-5-task-006

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Read input from stdin (pre-push hook receives: local_ref local_sha remote_ref remote_sha)
while read local_ref local_sha remote_ref remote_sha
do
    # Skip deleted refs
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    # Get list of commits being pushed
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # New branch - check all commits not in any remote branch
        commits=$(git log --format=%H "$local_sha" --not --remotes 2>/dev/null || true)
    else
        # Existing branch - check commits in range
        commits=$(git log --format=%H "$remote_sha..$local_sha" 2>/dev/null || true)
    fi

    if [ -z "$commits" ]; then
        continue
    fi

    # Check each commit for roadmap file changes
    has_unverified=false
    for commit in $commits; do
        # Get roadmap files changed in this commit
        roadmap_files=$(git diff-tree --no-commit-id --name-only -r "$commit" 2>/dev/null | grep "^.vibey/roadmap/.*\.yaml$" || true)

        if [ -z "$roadmap_files" ]; then
            continue
        fi

        # Run Python verification
        if ! python3 -c "
from vibey.operations.git.hooks.pre_push import PrePushHook
import sys
hook = PrePushHook()
result = hook._verify_commit('$commit')
if not result.verified:
    print(f'Commit $commit has unverified roadmap changes:')
    for f in result.unverified_files:
        print(f'  - {f}')
    sys.exit(1)
" 2>/dev/null; then
            has_unverified=true
        fi
    done

    if [ "$has_unverified" = "true" ]; then
        echo ""
        echo -e "${RED}❌ Pre-push verification failed!${NC}"
        echo ""
        echo -e "${YELLOW}Some commits contain roadmap changes without activity log entries.${NC}"
        echo -e "${YELLOW}Use 'vibey roadmap' CLI commands to make changes.${NC}"
        echo ""
        echo -e "${YELLOW}To bypass this check (emergency only): git push --no-verify${NC}"
        echo ""
        exit 1
    fi
done

# If we get here, all verifications passed
echo ""
echo -e "${GREEN}✅ Pre-push verification passed!${NC}"
echo ""

exit 0
